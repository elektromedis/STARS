# Salin menjadi .env (berkas .env tidak ikut Git). jalankan-*.bat melakukannya otomatis dan mengisi AUTH_SECRET.

# --- Basis data ---
# Pengembangan & intranet kecil: SQLite satu berkas. Docker: file:/app/data/stars.db (lihat deploy/).
DATABASE_URL="file:./dev.db"

# --- Autentikasi (Auth.js) ---
# Rahasia penandatangan sesi. Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-string-acak"
# Opsional bila diakses lewat domain publik: AUTH_URL="https://stars.domain-rs.go.id"

# Akun Super Admin PERTAMA, dibuat otomatis saat belum ada pengguna sama sekali. Ganti sandinya setelah login pertama.
SUPERADMIN_EMAIL="admin@rsudcipayung.local"
SUPERADMIN_PASSWORD="ganti-sandi-minimal-8"
SUPERADMIN_NAMA="Super Admin STARS"

# --- Mode & sinkronisasi (Tahap 3) ---
# intranet = sumber data (operator mengunggah di sini) | internet = baca saja, menerima sinkron
STARS_MODE="intranet"
# Token bersama (min. 16 karakter, sama di kedua server) untuk POST /api/sync
SYNC_TOKEN=""
# Hanya di server intranet: alamat server internet tujuan `npm run sync`
SYNC_URL=""

# Folder salinan berkas unggahan (opsional; default ./uploads)
# UPLOAD_DIR="D:/stars-uploads"
