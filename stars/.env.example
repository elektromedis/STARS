# Salin menjadi .env (berkas .env tidak ikut Git). jalankan-*.bat melakukannya otomatis dan mengisi AUTH_SECRET.

# --- Basis data ---
# Pengembangan & intranet kecil: SQLite satu berkas. Docker: file:/app/data/stars.db (lihat deploy/).
DATABASE_URL="file:./dev.db"

# --- Autentikasi (Auth.js) ---
# Rahasia penandatangan sesi. Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-string-acak"
# JANGAN isi AUTH_URL: STARS dibuka dari beberapa alamat (localhost, IP LAN, https Tailscale) dan
# otomatis mengikuti alamat yang sedang dipakai. AUTH_URL akan memaksa semua login kembali ke satu alamat.

# Akun Super Admin PERTAMA, dibuat otomatis saat belum ada pengguna sama sekali. Ganti sandinya setelah login pertama.
SUPERADMIN_EMAIL="admin@rsudcipayung.local"
SUPERADMIN_PASSWORD="ganti-sandi-minimal-8"
SUPERADMIN_NAMA="Super Admin STARS"

# --- Mode & sinkronisasi (Tahap 3) ---
# intranet = sumber data (operator mengunggah di sini) | internet = baca saja, menerima sinkron
STARS_MODE="intranet"
# Token bersama (min. 16 karakter, sama di kedua server) untuk POST /api/sync
SYNC_TOKEN=""
# Hanya di server intranet: alamat server internet tujuan `npm run sync`
SYNC_URL=""

# Alamat publik STARS yang ditanam di label QR alat (harus bisa dibuka dari HP), mis. alamat https Tailscale.
# Kosong = formulir cetak label memakai alamat halaman yang sedang dibuka.
# STARS_URL_PUBLIK="https://nama-pc.tailnet.ts.net"

# Folder salinan berkas unggahan (opsional; default ./uploads)
# UPLOAD_DIR="D:/stars-uploads"

# --- Integrasi Fiix CMMS (lihat docs/INTEGRASI-FIIX.md) ---
# Disiapkan untuk integrasi API resmi Fiix (BELUM dipakai; jangan isi sebelum integrasi dibuat):
# FIIX_API_URL=""
# FIIX_APP_KEY=""
# FIIX_ACCESS_KEY=""
# FIIX_SECRET_KEY=""

# --- Email (opsional) untuk "Lupa sandi": tautan setel ulang dikirim ke email pengguna ---
# Gmail: aktifkan Verifikasi 2 Langkah → buat "App Password" (16 huruf) di myaccount.google.com/apppasswords
# Isi juga STARS_URL_PUBLIK agar tautan di email mengarah ke alamat yang benar.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="akun-stars@gmail.com"
# SMTP_PASS="xxxxxxxxxxxxxxxx"
# SMTP_FROM="STARS RSUD Cipayung <akun-stars@gmail.com>"
