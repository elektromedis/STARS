# Salin menjadi deploy/.env lalu isi. JANGAN commit berkas .env ke Git.

# Rahasia sesi login. Buat: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-string-acak-32-byte

# Alamat yang dipakai pengguna. Intranet: http://192.168.x.x:3000  | Internet: https://stars.domain-rs.go.id
APP_URL=http://localhost:3000
APP_PORT=3000

# Super Admin pertama (dibuat otomatis saat belum ada pengguna). Ganti sandinya setelah login pertama.
SUPERADMIN_EMAIL=admin@rsudcipayung.go.id
SUPERADMIN_PASSWORD=ganti-sandi-minimal-8
SUPERADMIN_NAMA=Super Admin STARS

# intranet (sumber data) | internet (baca saja, menerima sinkron)
STARS_MODE=intranet

# Token bersama untuk sinkronisasi (min. 16 karakter, SAMA di server intranet dan internet)
SYNC_TOKEN=ganti-dengan-token-acak-panjang

# Hanya profil internet: domain publik untuk sertifikat HTTPS
STARS_DOMAIN=stars.example.id
