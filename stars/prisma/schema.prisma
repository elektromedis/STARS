// STARS — skema basis data Tahap 1.
// Pengembangan: SQLite (berkas prisma/dev.db). Produksi (Tahap 3): ganti provider ke "postgresql".

generator client {
  provider      = "prisma-client-js"
  // native = mesin pengembang (Windows); linux-musl = image Docker node:alpine (Tahap 3)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 28 unit kerja RSUD Cipayung (master). "TIDAK ADA" dipakai bila lokasi tidak cocok.
model UnitKerja {
  id          Int               @id @default(autoincrement())
  nama        String            @unique
  urut        Int               @default(0)
  paket       Paket[]
  pengguna    Pengguna[]
  alat        Alat[]
  permintaan  PermintaanKerja[]
  ruangan     Ruangan[]
  titikPantau LokasiPantau[]
}

/// Ruangan/lokasi fisik alat (mis. "PERINA Lt. 2"), di bawah satu unit kerja.
model Ruangan {
  id          Int       @id @default(autoincrement())
  nama        String
  gedung      String?
  unitKerja   UnitKerja @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId Int
  kepala      String?
  aktif       Boolean   @default(true)
  alat        Alat[]

  @@unique([nama, unitKerjaId])
  @@index([unitKerjaId])
}

/// Akun pengguna area admin. Peran: Viewer | Operator | Admin | Super Admin (Public = tanpa akun).
model Pengguna {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  nama           String
  sandiHash      String
  peran          String          @default("Viewer")
  unitKerja      UnitKerja?      @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId    Int? // Operator: hanya boleh mengunggah data unit ini
  aktif          Boolean         @default(true)
  gagalLogin     Int             @default(0)
  terkunciSampai DateTime?
  terakhirLogin  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  perintahKerja  PerintahKerja[] @relation("TeknisiPerintah")
}

/// Jejak aktivitas keamanan & administrasi (login, impor, kelola pengguna, cadangan, sinkron).
model AuditLog {
  id     Int      @id @default(autoincrement())
  waktu  DateTime @default(now())
  email  String?
  aksi   String
  objek  String?
  detail String?
  ip     String?

  @@index([waktu])
}

/// Satu baris RKPBU (pemeliharaan) atau RKBU (pengadaan/modal) alat kesehatan.
model Paket {
  id           Int       @id @default(autoincrement())
  kode         String    @unique
  tahun        Int
  tahap        String // Ranwal | Penetapan | Pergeseran | Perubahan | Perubahan II
  jenis        String // Pemeliharaan | Pengadaan
  sumberDana   String    @default("BLUD")
  namaRekening String
  namaPaket    String
  uraian       String?
  unitKerja    UnitKerja @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId  Int
  lokasiAsli   String? // teks lokasi apa adanya dari kertas kerja
  kodeBarang   String?
  vol1         Float     @default(1)
  satuan1      String?
  vol2         Float     @default(1)
  satuan2      String?
  hargaSatuan  Float
  nilai        Float
  serapan      Boolean   @default(false)
  prioritas    String?
  linkHarga    String?
  keterangan   String?
  kategori     String    @default("Pemeliharaan Lainnya")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tahun, tahap])
  @@index([unitKerjaId])
  @@index([kategori])
}

// ============================================================
// Modul Pemeliharaan Alat Kesehatan (CMMS internal STARS).
// Alur: Alat -> Permintaan Kerja (lapor kerusakan, publik) -> Perintah Kerja
// (work order, dikerjakan teknisi) -> Selesai. Jadwal Preventif opsional.
// Terpisah dari tabel Paket (RKPBU/RKBU) agar data pengadaan tidak tersentuh.
// ============================================================

/// Aset/alat kesehatan yang dipelihara. Kode = nomor inventaris (unik).
model Alat {
  id               Int               @id @default(autoincrement())
  kode             String            @unique
  nama             String
  merek            String?
  model            String?
  nomorSeri        String?
  unitKerja        UnitKerja         @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId      Int
  ruangan          Ruangan?          @relation(fields: [ruanganId], references: [id])
  ruanganId        Int?
  lokasi           String?
  kategori         String?
  jenis            String            @default("Medik") // Medik | Non Medik
  risiko           String? // Tinggi | Sedang | Rendah (klasifikasi EM)
  tahunPerolehan   Int?
  hargaPerolehan   Float?
  usiaTeknis       Int? // tahun
  garansiSampai    DateTime?
  kondisi          String            @default("Baik") // Baik | Rusak Ringan | Rusak Berat | Afkir
  aktif            Boolean           @default(true)
  catatan          String?
  // --- kolom warisan Trilux CAMS (impor inventaris) ---
  kodeAspak        String? // kode alat ASPAK/Trilux, mis. 20902005
  noUrutAset       String?
  instalasi        String? // teks asli Trilux
  pelayanan        String? // teks asli Trilux
  tahunPembelian   Int?
  tahunPembukuan   Int?
  pendanaan        String?
  teknologi        String?
  kelasRisiko      String? // teks asli, mis. "Medium (sedang)"
  akl              String?
  produsen         String?
  distributor      String?
  tanggalUjiFungsi DateTime?
  umurPemakaian    String?
  // --- foto alat (publik): UPLOAD_DIR/alat/<uuid>.jpg + gambar kecil <uuid>-kecil.jpg ---
  foto             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  permintaan       PermintaanKerja[]
  perintah         PerintahKerja[]
  jadwal           JadwalPreventif[]
  kalibrasi        Kalibrasi[]
  dokumen          DokumenAlat[]
  titikPantau      LokasiPantau[]

  @@index([unitKerjaId])
  @@index([kondisi])
  @@index([jenis])
}

/// Riwayat kalibrasi/pengujian alat beserta sertifikat & masa berlaku.
model Kalibrasi {
  id              Int       @id @default(autoincrement())
  alat            Alat      @relation(fields: [alatId], references: [id])
  alatId          Int
  tanggal         DateTime
  kalibrator      String // lembaga/institusi pengkalibrasi
  petugas         String?
  metode          String?
  laik            Boolean   @default(true)
  nomorSertifikat String?
  berlakuSampai   DateTime?
  keterangan      String?
  // --- sertifikat (CMS Kalibrasi) ---
  // Satu berkas boleh dipakai beberapa catatan (sertifikat/laporan kolektif); berkas dihapus bila tak dirujuk lagi.
  berkas          String? // nama simpan di UPLOAD_DIR/kalibrasi: <uuid>.<ext>
  namaBerkas      String? // nama asli saat diunggah
  tipeBerkas      String?
  ukuranBerkas    Int?
  diunggahOleh    String?
  jenis           String    @default("Kalibrasi") // Kalibrasi | Pengujian (menu Pengujian dan Kalibrasi)
  createdAt       DateTime  @default(now())

  @@index([alatId])
  @@index([berlakuSampai])
  @@index([berkas])
}

/// Permintaan kerja / laporan kerusakan. Dapat dibuat publik tanpa akun.
model PermintaanKerja {
  id             Int            @id @default(autoincrement())
  nomor          String         @unique // WR-2026-0001
  alat           Alat?          @relation(fields: [alatId], references: [id])
  alatId         Int?
  namaAlat       String // teks bila alat belum terdaftar
  unitKerja      UnitKerja?     @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId    Int?
  lokasi         String?
  pelapor        String
  kontak         String?
  keluhan        String
  prioritas      String         @default("Normal") // Rendah | Normal | Tinggi | Darurat
  foto           String?
  video          String? // video opsional (maks 20 MB), UPLOAD_DIR/permintaan
  kodeLacak      String? // token acak untuk pelapor melacak status tanpa akun (Riwayat/Notifikasi)
  status         String         @default("Baru") // Baru | Ditinjau | Diproses | Selesai | Ditolak
  catatanPetugas String?
  perintah       PerintahKerja?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Perintah kerja (work order) yang dikerjakan teknisi.
model PerintahKerja {
  id             Int              @id @default(autoincrement())
  nomor          String           @unique // WO-2026-0001
  permintaan     PermintaanKerja? @relation(fields: [permintaanId], references: [id])
  permintaanId   Int?             @unique
  alat           Alat?            @relation(fields: [alatId], references: [id])
  alatId         Int?
  jenis          String           @default("Korektif") // Korektif | Preventif
  deskripsi      String
  prioritas      String           @default("Normal")
  teknisi        Pengguna?        @relation("TeknisiPerintah", fields: [teknisiId], references: [id])
  teknisiId      Int?
  status         String           @default("Terbuka") // Terbuka | Dikerjakan | Selesai | Batal
  checklist      String? // daftar tugas, satu per baris; awali "[x]" bila selesai
  tindakan       String?
  sukuCadang     String?
  biaya          Float            @default(0)
  tanggalMulai   DateTime?
  tanggalSelesai DateTime?
  jadwal         JadwalPreventif? @relation(fields: [jadwalId], references: [id])
  jadwalId       Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([teknisiId])
  @@index([jadwalId])
}

/// Jadwal pemeliharaan preventif berkala per alat (UI penuh menyusul).
model JadwalPreventif {
  id           Int             @id @default(autoincrement())
  alat         Alat            @relation(fields: [alatId], references: [id])
  alatId       Int
  nama         String
  intervalHari Int // ulang setiap N hari
  checklist    String?
  terakhir     DateTime?
  berikutnya   DateTime?
  aktif        Boolean         @default(true)
  perintah     PerintahKerja[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([alatId])
  @@index([berikutnya])
}

/// Dokumen pendukung paket (RKPBU, AKPA, Nota Dinas, SP/SPK, Invoice/Faktur).
/// Ditautkan lewat KODE paket (bukan id) agar tetap menempel saat paket dihapus-lalu-diimpor ulang
/// (mode "ganti" memakai kode yang sama). Berkas disimpan di UPLOAD_DIR/dokumen.
model DokumenPaket {
  id           Int       @id @default(autoincrement())
  paketKode    String
  jenis        String // RKPBU | AKPA | NOTA_DINAS | SP_SPK | INVOICE
  namaBerkas   String // nama asli dari pengunggah
  berkas       String    @unique // nama tersimpan (uuid.ext)
  tipe         String // MIME
  ukuran       Int
  nomor        String?
  tanggal      DateTime?
  keterangan   String?
  diunggahOleh String?
  createdAt    DateTime  @default(now())

  @@index([paketKode, jenis])
}

/// Dokumen alat ala Trilux: File Penerimaan (Kontrak, BA Penerimaan, AKD/AKL, BA Uji Fungsi, BA Uji Coba)
/// dan File Pendukung (Garansi, SOP, User/Service Manual, SP Pemeliharaan/Perbaikan, Lainnya).
/// Satu berkas boleh dipakai beberapa alat (mis. User Manual untuk semua alat merek & tipe sama);
/// berkas di UPLOAD_DIR/dokumen-alat dihapus bila tidak dirujuk lagi. Sertifikat kalibrasi tetap di tabel Kalibrasi.
model DokumenAlat {
  id           Int       @id @default(autoincrement())
  alat         Alat      @relation(fields: [alatId], references: [id], onDelete: Cascade)
  alatId       Int
  jenis        String // lihat src/lib/dokumen-alat.ts
  namaBerkas   String
  berkas       String // nama tersimpan (uuid.ext), boleh sama untuk beberapa alat
  tipe         String // MIME
  ukuran       Int
  nomor        String?
  tanggal      DateTime?
  keterangan   String?
  diunggahOleh String?
  createdAt    DateTime  @default(now())

  @@index([alatId, jenis])
  @@index([berkas])
}

/// Jejak setiap percobaan penyimpanan impor Excel (untuk audit BLUD).
model LogImpor {
  id              Int      @id @default(autoincrement())
  waktu           DateTime @default(now())
  namaBerkas      String
  ukuranByte      Int
  pengguna        String?
  totalBaris      Int
  barisBaru       Int
  barisDiperbarui Int
  barisError      Int      @default(0)
  totalNilai      Float    @default(0)
  status          String // Berhasil | Gagal
  pesan           String?
  berkasTersimpan String?
}

/// Dokumen RKBU/RKPBU siap cetak (menu Perencanaan-Pengadaan → Cetak RKBU).
/// `isi` = JSON lengkap (kop, judul, identitas, baris tabel, catatan, penandatangan, lampiran; lihat src/lib/rkbu.ts).
/// Gambar logo kop & lampiran disimpan di UPLOAD_DIR/rkbu dan dirujuk dari `isi`.
model DokumenRkbu {
  id          Int      @id @default(autoincrement())
  judul       String
  jenis       String   @default("Pemeliharaan") // Pemeliharaan | Pengadaan
  tahun       Int
  tahap       String
  unit        String?
  jumlahBaris Int      @default(0)
  total       Float    @default(0)
  isi         String
  dibuatOleh  String?
  diubahOleh  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tahun, tahap])
}

/// Data HTA (Health Technology Assessment) per produk = merek + tipe/model.
/// `kunci` sama dengan kunci kelompok model alat di Inventaris (src/lib/hta.ts), sehingga data inventaris
/// (unit, kerusakan, kalibrasi, dokumen) dan data HTA (harga, garansi, spesifikasi) menyatu untuk produk yang sama.
/// Produk tanpa unit di inventaris = kandidat pengadaan (mis. dari e-Katalog).
model ProdukHta {
  id           Int      @id @default(autoincrement())
  kunci        String   @unique
  nama         String // jenis alat, mis. "Infusion Pump"
  merek        String?
  model        String?
  harga        Float? // harga per unit (e-Katalog/penawaran), termasuk PPN
  garansiBulan Int?
  usiaTeknis   Int? // umur teknis/ekonomis (tahun)
  tkdn         Float? // persen
  akl          String? // nomor izin edar AKL/AKD
  asal         String? // negara produsen
  penyedia     String? // distributor / service center
  tautan       String? // tautan e-Katalog / brosur
  spesifikasi  String? // JSON [{parameter, nilai, satuan, arah}]
  catatan      String?
  foto         String? // UPLOAD_DIR/alat (sama dengan foto alat)
  dibuatOleh   String?
  diubahOleh   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// Live Medical Device Environmental Monitoring (suhu & kelembapan dari sensor IoT)
// Konsep mengikuti LogTag Online: "Lokasi" = titik yang dipantau (kulkas vaksin, freezer,
// ruang alat); sensor boleh diganti tanpa memutus riwayat bacaan lokasi itu.
// ============================================================

model LokasiPantau {
  id              Int              @id @default(autoincrement())
  kode            String           @unique // mis. LP-001 (dipakai di URL /monitoring/<kode>)
  nama            String
  jenis           String           @default("Kulkas") // Kulkas | Kulkas darah | Freezer | Ruangan | Ruang operasi | Inkubator | Lainnya
  deskripsi       String?
  unitKerja       UnitKerja?       @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId     Int?
  alat            Alat?            @relation(fields: [alatId], references: [id], onDelete: SetNull)
  alatId          Int? // alat inventaris yang dipantau (mis. kulkas vaksin), opsional
  suhuMin         Float?
  suhuMaks        Float?
  lembapMin       Float?
  lembapMaks      Float?
  tundaAlarm      Int              @default(2) // alarm setelah N bacaan berturut-turut di luar batas
  batasPutusMenit Int              @default(15) // tanpa bacaan selama ini = "terputus"; 0 = tidak dipantau
  penanggungJawab String?
  aktif           Boolean          @default(true)
  // ringkasan bacaan terakhir (diperbarui saat data masuk; dashboard tidak perlu memindai tabel bacaan)
  terakhirWaktu   DateTime?
  terakhirSuhu    Float?
  terakhirLembap  Float?
  dibuatOleh      String?
  diubahOleh      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sensor          SensorIot?
  bacaan          BacaanSensor[]
  alarm           AlarmPantau[]
  inspeksi        InspeksiPantau[]

  @@index([unitKerjaId])
}

model SensorIot {
  id                Int           @id @default(autoincrement())
  serial            String        @unique // nomor seri / ID perangkat
  nama              String?
  model             String? // mis. ESP32 + SHT31, LogTag UTRED30-WiFi
  lokasi            LokasiPantau? @relation(fields: [lokasiId], references: [id], onDelete: SetNull)
  lokasiId          Int?          @unique // satu sensor aktif per lokasi
  tokenHash         String?       @unique // SHA-256 token API (token asli hanya ditampilkan sekali)
  tokenPetunjuk     String? // 4 karakter terakhir token, untuk dikenali
  terakhirTerhubung DateTime?
  baterai           Float? // persen
  sinyal            Int? // RSSI dBm
  aktif             Boolean       @default(true)
  dibuatOleh        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model BacaanSensor {
  lokasi   LokasiPantau @relation(fields: [lokasiId], references: [id], onDelete: Cascade)
  lokasiId Int
  waktu    DateTime
  suhu     Float?
  lembap   Float?
  serial   String? // sensor yang merekam (riwayat tetap utuh walau sensor diganti)
  sumber   String       @default("api") // api | impor | uji

  @@id([lokasiId, waktu])
}

model AlarmPantau {
  id         Int          @id @default(autoincrement())
  lokasi     LokasiPantau @relation(fields: [lokasiId], references: [id], onDelete: Cascade)
  lokasiId   Int
  jenis      String // suhu-tinggi | suhu-rendah | lembap-tinggi | lembap-rendah | putus
  mulai      DateTime
  selesai    DateTime? // null = masih berlangsung
  puncak     Float? // nilai paling ekstrem selama ekskursi
  batas      Float? // batas yang dilanggar
  // pengakuan + catatan insiden (Troubleshooting Record ala LogTag)
  diakuiOleh String?
  diakuiPada DateTime?
  tindakan   String?
  dampak     String? // produk/alat terdampak & keputusannya
  pencegahan String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([lokasiId, mulai])
  @@index([selesai])
}

model InspeksiPantau {
  id        Int          @id @default(autoincrement())
  lokasi    LokasiPantau @relation(fields: [lokasiId], references: [id], onDelete: Cascade)
  lokasiId  Int
  tanggal   String // YYYY-MM-DD (WIB)
  sesi      String // Pagi | Sore
  suhu      Float?
  lembap    Float?
  waktuBaca DateTime?
  oleh      String
  catatan   String?
  createdAt DateTime     @default(now())

  @@unique([lokasiId, tanggal, sesi])
}
