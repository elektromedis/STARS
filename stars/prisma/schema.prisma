// STARS — skema basis data Tahap 1.
// Pengembangan: SQLite (berkas prisma/dev.db). Produksi (Tahap 3): ganti provider ke "postgresql".

generator client {
  provider      = "prisma-client-js"
  // native = mesin pengembang (Windows); linux-musl = image Docker node:alpine (Tahap 3)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 28 unit kerja RSUD Cipayung (master). "TIDAK ADA" dipakai bila lokasi tidak cocok.
model UnitKerja {
  id          Int               @id @default(autoincrement())
  nama        String            @unique
  urut        Int               @default(0)
  paket       Paket[]
  pengguna    Pengguna[]
  alat        Alat[]
  permintaan  PermintaanKerja[]
  ruangan     Ruangan[]
  titikPantau LokasiPantau[]
}

/// Ruangan/lokasi fisik alat (mis. "PERINA Lt. 2"), di bawah satu unit kerja.
model Ruangan {
  id          Int       @id @default(autoincrement())
  nama        String
  gedung      String?
  unitKerja   UnitKerja @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId Int
  kepala      String?
  aktif       Boolean   @default(true)
  alat        Alat[]

  @@unique([nama, unitKerjaId])
  @@index([unitKerjaId])
}

/// Akun pengguna area admin. Peran: Viewer | Operator | Admin | Super Admin (Public = tanpa akun).
model Pengguna {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  nama           String
  sandiHash      String
  peran          String          @default("Viewer")
  unitKerja      UnitKerja?      @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId    Int? // Operator: hanya boleh mengunggah data unit ini
  aktif          Boolean         @default(true)
  gagalLogin     Int             @default(0)
  terkunciSampai DateTime?
  terakhirLogin  DateTime?
  /// true = mendaftar sendiri lewat /daftar dan belum disetujui Admin (selalu aktif=false sampai disetujui)
  menunggu       Boolean         @default(false)
  /// isian pendaftar: jabatan/keperluan (dibaca Admin saat menyetujui)
  catatanDaftar  String?
  /// token rahasia umpan kalender (.ics) pribadi untuk Google Calendar "Dari URL"
  tokenKalender  String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  perintahKerja  PerintahKerja[] @relation("TeknisiPerintah")
  tokenSandi     TokenSandi[]
}

/// Token sekali pakai "lupa sandi" (dikirim lewat email). Yang disimpan hanya sidik SHA-256; berlaku 30 menit.
model TokenSandi {
  id          Int       @id @default(autoincrement())
  pengguna    Pengguna  @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  penggunaId  Int
  hash        String    @unique
  kedaluwarsa DateTime
  dipakai     DateTime?
  createdAt   DateTime  @default(now())

  @@index([penggunaId])
}

/// Jejak aktivitas keamanan & administrasi (login, impor, kelola pengguna, cadangan, sinkron).
model AuditLog {
  id     Int      @id @default(autoincrement())
  waktu  DateTime @default(now())
  email  String?
  aksi   String
  objek  String?
  detail String?
  ip     String?

  @@index([waktu])
}

/// Satu baris RKPBU (pemeliharaan) atau RKBU (pengadaan/modal) alat kesehatan.
model Paket {
  id           Int       @id @default(autoincrement())
  kode         String    @unique
  tahun        Int
  tahap        String // Ranwal | Penetapan | Pergeseran | Perubahan | Perubahan II
  jenis        String // Pemeliharaan | Pengadaan
  sumberDana   String    @default("BLUD")
  namaRekening String
  namaPaket    String
  uraian       String?
  unitKerja    UnitKerja @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId  Int
  lokasiAsli   String? // teks lokasi apa adanya dari kertas kerja
  kodeBarang   String?
  vol1         Float     @default(1)
  satuan1      String?
  vol2         Float     @default(1)
  satuan2      String?
  hargaSatuan  Float
  nilai        Float
  serapan      Boolean   @default(false)
  prioritas    String?
  linkHarga    String?
  keterangan   String?
  kategori     String    @default("Pemeliharaan Lainnya")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tahun, tahap])
  @@index([unitKerjaId])
  @@index([kategori])
}

// ============================================================
// Modul Pemeliharaan Alat Kesehatan (CMMS internal STARS).
// Alur: Alat -> Permintaan Kerja (lapor kerusakan, publik) -> Perintah Kerja
// (work order, dikerjakan teknisi) -> Selesai. Jadwal Preventif opsional.
// Terpisah dari tabel Paket (RKPBU/RKBU) agar data pengadaan tidak tersentuh.
// ============================================================

/// Aset/alat kesehatan yang dipelihara. Kode = nomor inventaris (unik).
model Alat {
  id               Int               @id @default(autoincrement())
  kode             String            @unique
  nama             String
  merek            String?
  model            String?
  nomorSeri        String?
  unitKerja        UnitKerja         @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId      Int
  ruangan          Ruangan?          @relation(fields: [ruanganId], references: [id])
  ruanganId        Int?
  lokasi           String?
  kategori         String?
  jenis            String            @default("Medik") // Medik | Non Medik
  risiko           String? // Tinggi | Sedang | Rendah (klasifikasi EM)
  tahunPerolehan   Int?
  hargaPerolehan   Float?
  usiaTeknis       Int? // tahun
  garansiSampai    DateTime?
  kondisi          String            @default("Baik") // Baik | Rusak Ringan | Rusak Berat | Afkir
  aktif            Boolean           @default(true)
  catatan          String?
  // --- kolom warisan Trilux CAMS (impor inventaris) ---
  kodeAspak        String? // kode alat ASPAK/Trilux, mis. 20902005
  noUrutAset       String?
  instalasi        String? // teks asli Trilux
  pelayanan        String? // teks asli Trilux
  tahunPembelian   Int?
  tahunPembukuan   Int?
  pendanaan        String?
  teknologi        String?
  kelasRisiko      String? // teks asli, mis. "Medium (sedang)"
  akl              String?
  produsen         String?
  distributor      String?
  tanggalUjiFungsi DateTime?
  umurPemakaian    String?
  // --- data inventaris standar WHO (Introduction to medical equipment inventory management, 2011 — Tabel 1 & Lampiran B) ---
  statusOperasi         String    @default("Beroperasi") // Beroperasi | Tidak beroperasi
  alasanTidakOperasi    String? // Menunggu kalibrasi | Menunggu pemeliharaan | Dalam perbaikan | Menunggu suku cadang | Rusak tidak dapat diperbaiki | Lainnya
  dayaListrik           String? // 220 V | 110 V | 380 V / 3 fase | Baterai | Tanpa listrik
  versiPerangkatLunak   String? // software / firmware
  negaraAsal            String?
  tahunProduksi         Int?
  penanggungJawab       String? // pemilik / penanggung jawab di ruangan
  kontakPenanggungJawab String?
  tanggalInstalasi      DateTime?
  hasilUjiTerima        String? // hasil uji terima (acceptance test) saat instalasi
  penyediaServis        String? // vendor / bengkel servis
  kontrakServis         String? // nomor & ringkasan kontrak servis
  kontrakServisSampai   DateTime?
  persyaratanOperasi    String? // kebutuhan khusus operasi / servis (gas medik, ruang khusus, dll.)
  aksesori              String? // aksesori, BHP & suku cadang terkait (satu per baris)
  penggunaAlat          String? // Dokter, Perawat, Analis lab, … (dipisah koma)
  riwayatRecall         String? // recall / peringatan bahaya dari produsen/regulator
  pembuanganKhusus      Boolean   @default(false)
  // --- WHO 2025: nomenklatur & keberlanjutan ---
  emdnKode              String? // European Medical Device Nomenclature
  gmdnKode              String? // Global Medical Device Nomenclature
  udi                   String? // Unique Device Identification (DI+PI)
  dayaWatt              Float? // konsumsi daya nominal (W)
  kategoriLimbah        String? // Limbah elektronik | Mengandung baterai | Mengandung merkuri | Radioaktif | Infeksius | Umum
  tanggalInventarisasi  DateTime? // terakhir diverifikasi fisik (audit inventaris)
  // --- skor risiko inklusi (WHO, Lampiran A): EM Fennigkoh–Smith & EMR Wang–Levenson ---
  emFungsi              Int? // 2..10
  emRisiko              Int? // 1..5
  emPemeliharaan        Int? // 1..5
  emrMisiKritis         Int? // 1..10
  emrUtilisasi          Int? // 0..100 (%)
  emDinilaiPada         DateTime?
  // --- klasifikasi IKATEMI No. 1/2023 (tingkat teknologi & risiko alat elektromedik) ---
  ikatemiNama           String? // nama baku pada lampiran
  ikatemiFungsi         String? // Bedah dan Anestesi | Diagnostik | Laboratorium | Life Support | Radiologi | Terapi
  ikatemiTeknologi      String? // Sederhana | Menengah | Tinggi
  ikatemiRisiko         String? // Rendah | Menengah | Tinggi
  // --- foto alat (publik): UPLOAD_DIR/alat/<uuid>.jpg + gambar kecil <uuid>-kecil.jpg ---
  foto             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  permintaan       PermintaanKerja[]
  perintah         PerintahKerja[]
  jadwal           JadwalPreventif[]
  kalibrasi        Kalibrasi[]
  dokumen          DokumenAlat[]
  titikPantau      LokasiPantau[]
  auditItem        AuditItem[]
  riwayatEm        RiwayatEm[]

  @@index([unitKerjaId])
  @@index([kondisi])
  @@index([jenis])
}

/// Riwayat kalibrasi/pengujian alat beserta sertifikat & masa berlaku.
model Kalibrasi {
  id              Int       @id @default(autoincrement())
  alat            Alat      @relation(fields: [alatId], references: [id])
  alatId          Int
  tanggal         DateTime
  kalibrator      String // lembaga/institusi pengkalibrasi
  petugas         String?
  metode          String?
  laik            Boolean   @default(true)
  nomorSertifikat String?
  berlakuSampai   DateTime?
  keterangan      String?
  // --- sertifikat (CMS Kalibrasi) ---
  // Satu berkas boleh dipakai beberapa catatan (sertifikat/laporan kolektif); berkas dihapus bila tak dirujuk lagi.
  berkas          String? // nama simpan di UPLOAD_DIR/kalibrasi: <uuid>.<ext>
  namaBerkas      String? // nama asli saat diunggah
  tipeBerkas      String?
  ukuranBerkas    Int?
  diunggahOleh    String?
  jenis           String    @default("Kalibrasi") // Kalibrasi | Pengujian (menu Pengujian dan Kalibrasi)
  createdAt       DateTime  @default(now())

  @@index([alatId])
  @@index([berlakuSampai])
  @@index([berkas])
}

/// Permintaan kerja / laporan kerusakan. Dapat dibuat publik tanpa akun.
model PermintaanKerja {
  id             Int            @id @default(autoincrement())
  nomor          String         @unique // WR-2026-0001
  alat           Alat?          @relation(fields: [alatId], references: [id])
  alatId         Int?
  namaAlat       String // teks bila alat belum terdaftar
  unitKerja      UnitKerja?     @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId    Int?
  lokasi         String?
  pelapor        String
  kontak         String?
  keluhan        String
  prioritas      String         @default("Normal") // Rendah | Normal | Tinggi | Darurat
  foto           String?
  video          String? // video opsional (maks 20 MB), UPLOAD_DIR/permintaan
  kodeLacak      String? // token acak untuk pelapor melacak status tanpa akun (Riwayat/Notifikasi)
  status         String         @default("Baru") // Baru | Ditinjau | Diproses | Selesai | Ditolak
  catatanPetugas String?
  perintah       PerintahKerja?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Perintah kerja (work order) yang dikerjakan teknisi.
model PerintahKerja {
  id             Int              @id @default(autoincrement())
  nomor          String           @unique // WO-2026-0001
  permintaan     PermintaanKerja? @relation(fields: [permintaanId], references: [id])
  permintaanId   Int?             @unique
  alat           Alat?            @relation(fields: [alatId], references: [id])
  alatId         Int?
  jenis          String           @default("Korektif") // Korektif | Preventif
  deskripsi      String
  prioritas      String           @default("Normal")
  teknisi        Pengguna?        @relation("TeknisiPerintah", fields: [teknisiId], references: [id])
  teknisiId      Int?
  status         String           @default("Terbuka") // Terbuka | Dikerjakan | Selesai | Batal
  checklist      String? // daftar tugas, satu per baris; awali "[x]" bila selesai
  tindakan       String?
  sukuCadang     String?
  biaya          Float            @default(0)
  tanggalMulai   DateTime?
  tanggalSelesai DateTime?
  jadwal         JadwalPreventif? @relation(fields: [jadwalId], references: [id])
  jadwalId       Int?
  // --- IMMS: alur perbaikan Permenkes 65/2016 & prioritas WHO IMMIS 2025 ---
  tanggapanPada  DateTime? // pertama kali ditangani (waktu tanggap)
  analisis       String? // pengecekan kondisi & analisis kerusakan
  pelaksana      String? // Internal | Pihak Ketiga
  perluSukuCadang Boolean         @default(false)
  usulan         String? // isi usulan: suku cadang / alasan pihak ke-3
  perkiraanBiaya Float?
  usulanStatus   String? // Diajukan | Disetujui | Ditolak (null = tidak perlu usulan)
  usulanOleh     String?
  usulanCatatan  String?
  usulanPada     DateTime?
  ujiFungsi      String? // Laik | Tidak laik
  hasilInspeksi  String? // JSON lembar inspeksi (kondisi, keberadaan, keselamatan, unjuk kerja)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([teknisiId])
  @@index([jadwalId])
}

/// Jadwal pemeliharaan preventif berkala per alat (UI penuh menyusul).
model JadwalPreventif {
  id           Int             @id @default(autoincrement())
  alat         Alat            @relation(fields: [alatId], references: [id])
  alatId       Int
  nama         String
  intervalHari Int // ulang setiap N hari
  checklist    String?
  terakhir     DateTime?
  berikutnya   DateTime?
  aktif        Boolean         @default(true)
  perintah     PerintahKerja[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([alatId])
  @@index([berikutnya])
}

/// Dokumen pendukung paket (RKPBU, AKPA, Nota Dinas, SP/SPK, Invoice/Faktur).
/// Ditautkan lewat KODE paket (bukan id) agar tetap menempel saat paket dihapus-lalu-diimpor ulang
/// (mode "ganti" memakai kode yang sama). Berkas disimpan di UPLOAD_DIR/dokumen.
model DokumenPaket {
  id           Int       @id @default(autoincrement())
  paketKode    String
  jenis        String // RKPBU | AKPA | NOTA_DINAS | SP_SPK | INVOICE
  namaBerkas   String // nama asli dari pengunggah
  berkas       String    @unique // nama tersimpan (uuid.ext)
  tipe         String // MIME
  ukuran       Int
  nomor        String?
  tanggal      DateTime?
  keterangan   String?
  diunggahOleh String?
  createdAt    DateTime  @default(now())

  @@index([paketKode, jenis])
}

/// Dokumen alat ala Trilux: File Penerimaan (Kontrak, BA Penerimaan, AKD/AKL, BA Uji Fungsi, BA Uji Coba)
/// dan File Pendukung (Garansi, SOP, User/Service Manual, SP Pemeliharaan/Perbaikan, Lainnya).
/// Satu berkas boleh dipakai beberapa alat (mis. User Manual untuk semua alat merek & tipe sama);
/// berkas di UPLOAD_DIR/dokumen-alat dihapus bila tidak dirujuk lagi. Sertifikat kalibrasi tetap di tabel Kalibrasi.
model DokumenAlat {
  id           Int       @id @default(autoincrement())
  alat         Alat      @relation(fields: [alatId], references: [id], onDelete: Cascade)
  alatId       Int
  jenis        String // lihat src/lib/dokumen-alat.ts
  namaBerkas   String
  berkas       String // nama tersimpan (uuid.ext), boleh sama untuk beberapa alat
  tipe         String // MIME
  ukuran       Int
  nomor        String?
  tanggal      DateTime?
  keterangan   String?
  diunggahOleh String?
  createdAt    DateTime  @default(now())

  @@index([alatId, jenis])
  @@index([berkas])
}

/// Jejak setiap percobaan penyimpanan impor Excel (untuk audit BLUD).
model LogImpor {
  id              Int      @id @default(autoincrement())
  waktu           DateTime @default(now())
  namaBerkas      String
  ukuranByte      Int
  pengguna        String?
  totalBaris      Int
  barisBaru       Int
  barisDiperbarui Int
  barisError      Int      @default(0)
  totalNilai      Float    @default(0)
  status          String // Berhasil | Gagal
  pesan           String?
  berkasTersimpan String?
}

/// Dokumen RKBU/RKPBU siap cetak (menu Perencanaan-Pengadaan → Cetak RKBU).
/// `isi` = JSON lengkap (kop, judul, identitas, baris tabel, catatan, penandatangan, lampiran; lihat src/lib/rkbu.ts).
/// Gambar logo kop & lampiran disimpan di UPLOAD_DIR/rkbu dan dirujuk dari `isi`.
model DokumenRkbu {
  id          Int      @id @default(autoincrement())
  judul       String
  jenis       String   @default("Pemeliharaan") // Pemeliharaan | Pengadaan
  tahun       Int
  tahap       String
  unit        String?
  jumlahBaris Int      @default(0)
  total       Float    @default(0)
  isi         String
  dibuatOleh  String?
  diubahOleh  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tahun, tahap])
}

/// Data HTA (Health Technology Assessment) per produk = merek + tipe/model.
/// `kunci` sama dengan kunci kelompok model alat di Inventaris (src/lib/hta.ts), sehingga data inventaris
/// (unit, kerusakan, kalibrasi, dokumen) dan data HTA (harga, garansi, spesifikasi) menyatu untuk produk yang sama.
/// Produk tanpa unit di inventaris = kandidat pengadaan (mis. dari e-Katalog).
model ProdukHta {
  id           Int      @id @default(autoincrement())
  kunci        String   @unique
  nama         String // jenis alat, mis. "Infusion Pump"
  merek        String?
  model        String?
  harga        Float? // harga per unit (e-Katalog/penawaran), termasuk PPN
  garansiBulan Int?
  usiaTeknis   Int? // umur teknis/ekonomis (tahun)
  tkdn         Float? // persen
  akl          String? // nomor izin edar AKL/AKD
  asal         String? // negara produsen
  penyedia     String? // distributor / service center
  tautan       String? // tautan e-Katalog / brosur
  spesifikasi  String? // JSON [{parameter, nilai, satuan, arah}]
  catatan      String?
  foto         String? // UPLOAD_DIR/alat (sama dengan foto alat)
  dibuatOleh   String?
  diubahOleh   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// Live Medical Device Environmental Monitoring (suhu & kelembapan dari sensor IoT)
// Konsep mengikuti LogTag Online: "Lokasi" = titik yang dipantau (kulkas vaksin, freezer,
// ruang alat); sensor boleh diganti tanpa memutus riwayat bacaan lokasi itu.
// ============================================================

model LokasiPantau {
  id              Int              @id @default(autoincrement())
  kode            String           @unique // mis. LP-001 (dipakai di URL /monitoring/<kode>)
  nama            String
  jenis           String           @default("Kulkas") // Kulkas | Kulkas darah | Freezer | Ruangan | Ruang operasi | Inkubator | Lainnya
  deskripsi       String?
  unitKerja       UnitKerja?       @relation(fields: [unitKerjaId], references: [id])
  unitKerjaId     Int?
  alat            Alat?            @relation(fields: [alatId], references: [id], onDelete: SetNull)
  alatId          Int? // alat inventaris yang dipantau (mis. kulkas vaksin), opsional
  suhuMin         Float?
  suhuMaks        Float?
  lembapMin       Float?
  lembapMaks      Float?
  tundaAlarm      Int              @default(2) // alarm setelah N bacaan berturut-turut di luar batas
  batasPutusMenit Int              @default(15) // tanpa bacaan selama ini = "terputus"; 0 = tidak dipantau
  penanggungJawab String?
  aktif           Boolean          @default(true)
  // ringkasan bacaan terakhir (diperbarui saat data masuk; dashboard tidak perlu memindai tabel bacaan)
  terakhirWaktu   DateTime?
  terakhirSuhu    Float?
  terakhirLembap  Float?
  dibuatOleh      String?
  diubahOleh      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sensor          SensorIot?
  bacaan          BacaanSensor[]
  alarm           AlarmPantau[]
  inspeksi        InspeksiPantau[]

  @@index([unitKerjaId])
}

model SensorIot {
  id                Int           @id @default(autoincrement())
  serial            String        @unique // nomor seri / ID perangkat
  nama              String?
  model             String? // mis. ESP32 + SHT31, LogTag UTRED30-WiFi
  lokasi            LokasiPantau? @relation(fields: [lokasiId], references: [id], onDelete: SetNull)
  lokasiId          Int?          @unique // satu sensor aktif per lokasi
  tokenHash         String?       @unique // SHA-256 token API (token asli hanya ditampilkan sekali)
  tokenPetunjuk     String? // 4 karakter terakhir token, untuk dikenali
  terakhirTerhubung DateTime?
  baterai           Float? // persen
  sinyal            Int? // RSSI dBm
  aktif             Boolean       @default(true)
  dibuatOleh        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model BacaanSensor {
  lokasi   LokasiPantau @relation(fields: [lokasiId], references: [id], onDelete: Cascade)
  lokasiId Int
  waktu    DateTime
  suhu     Float?
  lembap   Float?
  serial   String? // sensor yang merekam (riwayat tetap utuh walau sensor diganti)
  sumber   String       @default("api") // api | impor | uji

  @@id([lokasiId, waktu])
}

model AlarmPantau {
  id         Int          @id @default(autoincrement())
  lokasi     LokasiPantau @relation(fields: [lokasiId], references: [id], onDelete: Cascade)
  lokasiId   Int
  jenis      String // suhu-tinggi | suhu-rendah | lembap-tinggi | lembap-rendah | putus
  mulai      DateTime
  selesai    DateTime? // null = masih berlangsung
  puncak     Float? // nilai paling ekstrem selama ekskursi
  batas      Float? // batas yang dilanggar
  // pengakuan + catatan insiden (Troubleshooting Record ala LogTag)
  diakuiOleh String?
  diakuiPada DateTime?
  tindakan   String?
  dampak     String? // produk/alat terdampak & keputusannya
  pencegahan String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([lokasiId, mulai])
  @@index([selesai])
}

model InspeksiPantau {
  id        Int          @id @default(autoincrement())
  lokasi    LokasiPantau @relation(fields: [lokasiId], references: [id], onDelete: Cascade)
  lokasiId  Int
  tanggal   String // YYYY-MM-DD (WIB)
  sesi      String // Pagi | Sore
  suhu      Float?
  lembap    Float?
  waktuBaca DateTime?
  oleh      String
  catatan   String?
  createdAt DateTime     @default(now())

  @@unique([lokasiId, tanggal, sesi])
}

/// Pengaturan sistem sederhana (kunci-nilai), mis. nomor WhatsApp admin untuk laporan kerusakan.
model Pengaturan {
  kunci      String   @id
  nilai      String
  diubahOleh String?
  updatedAt  DateTime @updatedAt
}

/// Inventaris pendukung (WHO): suku cadang, bahan habis pakai (BHP), alat kerja & alat uji bengkel.
model BarangStok {
  id              Int          @id @default(autoincrement())
  kode            String       @unique
  nama            String
  jenis           String // Suku cadang | BHP | Alat kerja | Alat uji
  satuan          String       @default("pcs")
  stok            Int          @default(0)
  stokMinimum     Int          @default(0) // titik pesan ulang
  lokasi          String?
  nomorLot        String?
  kedaluwarsa     DateTime?
  kalibrasiSampai DateTime? // khusus alat uji
  harga           Float?
  alatTerkait     String? // alat yang memakai (nama / model)
  pemasok         String?
  catatan         String?
  aktif           Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  mutasi          MutasiStok[]

  @@index([jenis])
}

model MutasiStok {
  id          Int        @id @default(autoincrement())
  barang      BarangStok @relation(fields: [barangId], references: [id], onDelete: Cascade)
  barangId    Int
  jenis       String // Masuk | Keluar | Penyesuaian
  jumlah      Int
  stokSetelah Int
  keterangan  String?
  oleh        String?
  waktu       DateTime   @default(now())

  @@index([barangId, waktu])
}

/// Audit inventaris tahunan (WHO): verifikasi fisik tiap alat per ruangan.
model AuditInventaris {
  id          Int         @id @default(autoincrement())
  tahun       Int
  nama        String
  status      String      @default("Berjalan") // Berjalan | Selesai
  dibuatOleh  String?
  createdAt   DateTime    @default(now())
  selesaiPada DateTime?
  item        AuditItem[]
}

model AuditItem {
  id            Int             @id @default(autoincrement())
  audit         AuditInventaris @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId       Int
  alat          Alat            @relation(fields: [alatId], references: [id], onDelete: Cascade)
  alatId        Int
  ditemukan     Boolean
  kondisiSesuai Boolean         @default(true)
  lokasiSesuai  Boolean         @default(true)
  catatan       String?
  oleh          String?
  waktu         DateTime        @default(now())

  @@unique([auditId, alatId])
}

/// Tanda tangan elektronik (TTE) dokumen STARS — mis. serah terima laporan kerusakan (teknisi & pelapor).
/// QR di PDF memuat tautan /verifikasi?t=<token>; hashIsi = SHA-256 isi dokumen saat ditandatangani.
model TandaTangan {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  dokumen   String // "Laporan Kerusakan"
  nomor     String // nomor dokumen, mis. WR-2026-0001
  peran     String // Teknisi | Pelapor
  nama      String
  identitas String? // email teknisi / kontak pelapor (disamarkan)
  hashIsi   String
  ip        String?
  waktu     DateTime @default(now())

  @@unique([nomor, peran])
  @@index([nomor])
}

/// Peminjaman alat antar unit kerja dengan persetujuan TTE (unit pemilik) & serah terima; RFID dalam pengembangan.
model Peminjaman {
  id             Int       @id @default(autoincrement())
  nomor          String    @unique // PJ-2026-0001
  alatId         Int
  dariUnitId     Int // unit pemilik alat
  keUnitId       Int // unit peminjam
  peminjam       String // nama pengaju
  pemohonEmail   String?
  keperluan      String
  tanggalPinjam  DateTime
  rencanaKembali DateTime
  tanggalKembali DateTime?
  status         String    @default("Diajukan") // Diajukan | Disetujui | Ditolak | Dipinjam | Dikembalikan
  kondisiKembali String?
  catatan        String?
  rfidTag        String? // [dalam pengembangan]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([alatId])
}

/// Penghapusan alat (WHO Decommissioning medical devices 2019; WHO 2025 7.10–7.13). Nomor HPS-YYYY-NNNN.
model Penghapusan {
  id            Int      @id @default(autoincrement())
  nomor         String   @unique
  alatId        Int
  alasan        String // Rusak berat | Usang/obsolete | Tidak ekonomis | Tidak aman | Lainnya
  keterangan    String?
  dekontaminasi Boolean  @default(false)
  dataDihapus   Boolean  @default(false) // data pasien dihapus aman
  tujuan        String // Dibuang | Didonasikan | Dijual | Tukar tambah | Dialihkan internal
  kategoriLimbah String?
  status        String   @default("Diajukan") // Diajukan | Diverifikasi | Disetujui | Ditolak
  pengusul      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([alatId])
}

/// Pengaturan situs (CMS bilah info, footer, kontak, tautan) — satu baris per kunci, nilai JSON.
model PengaturanSitus {
  kunci     String   @id
  nilai     String
  updatedAt DateTime @updatedAt
}

/// Iklan/pengumuman pop-up di beranda.
model Pengumuman {
  id        Int       @id @default(autoincrement())
  judul     String
  gambar    String? // nama berkas di UPLOAD_DIR/situs
  tautan    String?
  aktif     Boolean   @default(true)
  mulai     DateTime?
  selesai   DateTime?
  urut      Int       @default(0)
  createdAt DateTime  @default(now())
}

/// Etalase situs (CMS): akreditasi & penghargaan, mitra kami.
model ItemSitus {
  id        Int      @id @default(autoincrement())
  jenis     String // "akreditasi" | "mitra"
  judul     String
  judulEn   String?
  gambar    String? // nama berkas di UPLOAD_DIR/situs
  tautan    String?
  aktif     Boolean  @default(true)
  urut      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([jenis, aktif])
}

/// JDIH — Jaringan Dokumentasi dan Informasi Hukum (produk hukum terkait alat kesehatan & STARS).
model Peraturan {
  id         Int      @id @default(autoincrement())
  jenis      String // UU, PP, Perpres, Permenkes, Kepmenkes, Permendagri, PermenPAN-RB, Pergub, Kepdir, SOP, Pedoman WHO, dll.
  nomor      String
  tahun      Int
  judul      String // "tentang …"
  pemrakarsa String?
  subjek     String? // Alat Kesehatan, Pengadaan, Barang Milik Daerah, SDM, Data & TTE, Mutu & Akreditasi
  status     String   @default("Berlaku") // Berlaku | Diubah | Dicabut
  keterangan String?
  tautan     String?
  berkas     String? // PDF di UPLOAD_DIR/jdih
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([jenis, tahun])
}

/// Template lembar kerja IPM per jenis alat — Pedoman Pengoperasian & Pemeliharaan Peralatan Kesehatan (Kemenkes 2021), Bab IV.
model TemplateLembarKerja {
  id         Int      @id @default(autoincrement())
  nama       String   @unique // jenis alat, mis. "Infusion Pump"
  kataKunci  String? // pencocok nama alat inventaris, dipisah koma
  halaman    Int? // halaman pedoman
  kualitatif String // satu butir per baris
  kuantitatif String // "Parameter | kriteria" per baris
  preventif  String // satu butir per baris
  lengkap    Boolean  @default(false) // butir sudah disalin dari pedoman
  aktif      Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

/// Lembar kerja Pemantauan Fungsi/Inspeksi & Pemeliharaan Preventif (Permenkes 15/2023 Pasal 3) + persetujuan TTE.
model LembarKerja {
  id           Int      @id @default(autoincrement())
  nomor        String   @unique // LK-2026-0001
  kegiatan     String // Inspeksi | Preventif
  tipeInspeksi String   @default("Terjadwal") // Acceptance | Terjadwal
  alatId       Int
  template     String?
  tanggal      DateTime
  hasil        String // Lolos | Memerlukan pemeliharaan | Preventable problem | KTD
  perhatian    String?
  data         String // JSON: apparatus, kualitatif, kuantitatif, preventif
  catatan      String?
  status       String   @default("Draf") // Draf | Diajukan | Disetujui | Ditolak
  pemeriksa    String
  emailPemeriksa String?
  alasanTolak  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([alatId])
  @@index([kegiatan, status])
}

/// Pemeliharaan promotif: petunjuk penggunaan/pengoperasian alat kepada pengguna (Pasal 3 ayat 3).
model KegiatanPromotif {
  id        Int      @id @default(autoincrement())
  tanggal   DateTime
  alatId    Int?
  namaAlat  String
  unit      String?
  materi    String
  pemateri  String
  peserta   Int      @default(0)
  catatan   String?
  createdAt DateTime @default(now())
}

/// Basis pengetahuan ALLIES: dokumen rujukan yang dipotong per halaman agar jawaban bisa menyebut sumbernya.
model DokumenPengetahuan {
  id        Int                   @id @default(autoincrement())
  judul     String
  jenis     String                @default("Pedoman")
  halaman   Int                   @default(0)
  oleh      String?
  createdAt DateTime              @default(now())
  potongan  PotonganPengetahuan[]
}

model PotonganPengetahuan {
  id        Int                @id @default(autoincrement())
  dokumenId Int
  halaman   Int
  urut      Int
  teks      String
  dokumen   DokumenPengetahuan @relation(fields: [dokumenId], references: [id], onDelete: Cascade)

  @@index([dokumenId, halaman])
}

/// IMMS: setiap perhitungan nilai EM (F + A + M + H, Permenkes 65/2016) disimpan agar perubahan akibat kerusakan dapat ditelusuri.
model RiwayatEm {
  id           Int      @id @default(autoincrement())
  alat         Alat     @relation(fields: [alatId], references: [id], onDelete: Cascade)
  alatId       Int
  fungsi       Int
  aplikasi     Int
  pemeliharaan Int
  riwayat      Int
  total        Int
  kerusakan    Int // jumlah perbaikan 30 bulan terakhir
  intervalBulan Int? // frekuensi jadwal hasil hitung (null = tidak dijadwalkan)
  sebab        String // Penilaian | Perbaikan selesai | Hitung ulang
  oleh         String?
  waktu        DateTime @default(now())

  @@index([alatId, waktu])
}

/// Pemetaan baris STARS ↔ TRILUX untuk sinkronisasi dua arah tanpa bentrok.
/// `hash` = sidik isi bersama saat sinkron terakhir; dipakai untuk tahu sisi mana yang berubah.
model SinkronTrilux {
  id       Int      @id @default(autoincrement())
  entitas  String // ruangan | alat | perintah | kalibrasi | keluhan | suku | jadwal
  idStars  Int
  idTrilux Int
  asal     String // stars | trilux (tempat baris pertama kali dibuat)
  hash     String
  waktu    DateTime @default(now()) @updatedAt

  @@unique([entitas, idStars])
  @@unique([entitas, idTrilux])
}
